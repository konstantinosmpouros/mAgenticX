{
  "uid": "magenticx-user-flow",
  "title": "magenticX — User flow",
  "tags": ["magenticx"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "user_id",
        "label": "User id (raw, matches DB)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Requests (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "noValue": "0", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({stack=\"magenticx\"} |= \"$user_id\" | json | user_id=\"$user_id\" | event=\"http_request_completed\" [$__range]))" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Errors (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "noValue": "0", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({stack=\"magenticx\", level=\"ERROR\"} |= \"$user_id\" | json | user_id=\"$user_id\" [$__range]))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Agent runs (range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "noValue": "0", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({stack=\"magenticx\", service=\"magenticx_agents\"} |= \"$user_id\" | json | user_id=\"$user_id\" | event=\"agent_stream_request_received\" [$__range]))" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Activity /min (all events)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (service) (count_over_time({stack=\"magenticx\"} |= \"$user_id\" | json | user_id=\"$user_id\" [1m]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "HTTP status /min",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (status_code) (count_over_time({stack=\"magenticx\", service=\"magenticx_dialogue_bridge\"} |= \"$user_id\" | json | user_id=\"$user_id\" | event=\"http_request_completed\" [1m]))", "legendFormat": "{{status_code}}" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Latency p95 (ms)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "quantile_over_time(0.95, {stack=\"magenticx\", service=\"magenticx_dialogue_bridge\"} |= \"$user_id\" |= \"http_request_completed\" | json lat=\"fields.duration_ms\", uid=\"user_id\" | uid=\"$user_id\" | unwrap lat [5m])", "legendFormat": "p95" } ]
    },
    {
      "id": 7, "type": "logs", "title": "Full flow — every event for this user (bridge → agents → rag)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 11 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{stack=\"magenticx\"} |= \"$user_id\" | json | user_id=\"$user_id\"" } ]
    }
  ]
}
