# Internal TLS certs (generated, contain private keys): every per-service
# folder generate-certs.sh writes, and the CA. Only the scripts in tls/ itself
# are tracked, so a new service's folder is ignored without editing this list.
magenticx/tls/*/
*.key

# pytest bootstrap artifacts (tests/dialogue_bridge/conftest.py seeds a sqlite
# DATABASE_URL at import time so settings can load; the file itself is disposable)
.pytest-bootstrap-*.db
.pytest_cache/

# Implementation plans — local working notes, not part of the repo history
plans/

