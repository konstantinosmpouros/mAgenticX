{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. All on, and green — keep it that way.
       `strict` enables the whole family (noImplicitAny, strictNullChecks,
       strictFunctionTypes, …). It was expected to cost ~100 errors; the real
       figure after the cleanup was 52, and 44 of those traced to a single
       over-wide `ToastLike` parameter type. Do not switch any of these back off
       to land a change — a new error here is a real defect, not friction. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* No `baseUrl`: it is deprecated in TS 6+, and `paths` resolves relative to
       this file on its own since TS 5.0. See tsconfig.json for the full story. */
    "paths": {
      "@/*": ["./src/*"],
      /* The test files sit outside this package, so Node-style resolution walks
         up from `tests/agentic_ui/` and never reaches this package's
         node_modules. These two entries point the test-only imports back here. */
      "vitest": ["./node_modules/vitest"],
      "@testing-library/*": ["./node_modules/@testing-library/*"],
      // Point at the TYPE declarations, not the .js: mapping these to the
      // runtime files makes every .tsx in src lose its JSX types.
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"]
    }
  },
  /* The JS tests live outside this package (repo-level `tests/agentic_ui/`,
     beside the Python contract tests) but are type-checked with the same
     settings as the app. That is deliberate: `session.test.ts` asserts that
     `isSessionValid` NARROWS its argument, which is a compile-time claim — it
     would pass at runtime even if the predicate regressed to plain `boolean`. */
  "include": ["src", "../../tests/agentic_ui"]
}
