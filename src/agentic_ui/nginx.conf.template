server {
  listen 80;

  # TLS listener and upstream SSL verification (generated at container startup
  # by entrypoint-nginx-tls.sh).  The glob pattern ensures Nginx starts cleanly
  # in local dev where no entrypoint runs and the file does not exist.
  include /etc/nginx/conf.d/tls.inc*;

  server_name _;

  set $trusted_client_ip $http_x_real_ip;
  if ($trusted_client_ip = "") {
    set $trusted_client_ip $remote_addr;
  }

  set $trusted_forwarded_for $http_x_forwarded_for;
  if ($trusted_forwarded_for = "") {
    set $trusted_forwarded_for $remote_addr;
  }

  set $trusted_cf_connecting_ip $http_cf_connecting_ip;
  if ($trusted_cf_connecting_ip = "") {
    set $trusted_cf_connecting_ip $trusted_client_ip;
  }

  set $trusted_forwarded_proto $http_x_forwarded_proto;
  if ($trusted_forwarded_proto = "") {
    set $trusted_forwarded_proto $scheme;
  }

  # Browser security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';" always;

  # Keep request bodies bounded; the app also validates lower logical limits.
  client_max_body_size 50M;

  # Give users enough time to upload larger bodies
  client_body_timeout 60s;

  root /usr/share/nginx/html;
  index index.html;

  # Defer DNS resolution to request time so nginx starts even if backend is down.
  # Note: proxy_pass with a variable skips automatic URI stripping, so we use
  # rewrite to manually strip the /api/ prefix before forwarding.
  resolver 127.0.0.11 valid=10s;
  set $bff ${BFF_BASE_URL};

  # Proxy API requests to backend service inside docker network
  location ^~ /api/v1/attachments/preview/ {
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self';" always;

    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $trusted_client_ip;
    proxy_set_header X-Forwarded-For $trusted_forwarded_for;
    proxy_set_header CF-Connecting-IP $trusted_cf_connecting_ip;
    proxy_set_header X-Forwarded-Proto $trusted_forwarded_proto;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location /api/ {
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $trusted_client_ip;
    proxy_set_header X-Forwarded-For $trusted_forwarded_for;
    proxy_set_header CF-Connecting-IP $trusted_cf_connecting_ip;
    proxy_set_header X-Forwarded-Proto $trusted_forwarded_proto;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};

    # Forward Range headers for partial content support
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;

    # Helpful for big requests: stream directly to backend instead of buffering to disk
    proxy_request_buffering off;

    # Don't buffer responses; stream to client for SSE and long downloads
    proxy_buffering off;

    gzip off;  # or ensure octet-stream isn't in gzip_types

    # Avoid premature timeouts while backend reads/processes big bodies
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Single Page App routing + static assets
  location / {
    try_files $uri $uri/ /index.html;
  }
}
