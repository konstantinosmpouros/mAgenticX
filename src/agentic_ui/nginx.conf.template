# Connection-upgrade map: forwards `Upgrade: websocket` on WS handshakes and
# closes the upstream connection on regular HTTP. Required by the inference
# WebSocket endpoint. The map directive lives at http{} scope; conf.d files
# are included inside http{} so placing it here is valid.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Correlation id for end-to-end tracing: forward the browser's X-Request-ID when
# present, otherwise mint one at the edge ($request_id) so every request carries
# one. The bridge re-validates it, so a forged/oversized client value is harmless.
map $http_x_request_id $req_id {
  ""      $request_id;
  default $http_x_request_id;
}

server {
  listen 80;

  # TLS listener and upstream SSL verification (generated at container startup
  # by entrypoint-nginx-tls.sh).  The glob pattern ensures Nginx starts cleanly
  # in local dev where no entrypoint runs and the file does not exist.
  include /etc/nginx/conf.d/tls.inc*;

  server_name _;

  # Hide the nginx version banner from responses (info-disclosure hardening).
  server_tokens off;

  # Trust real client IP from NPM (which sits in front on the `proxy` docker network).
  # `set_real_ip_from` restricts honoring the header to connections from the proxy
  # network; anything else falls back to the actual TCP peer, so external clients
  # cannot spoof their IP. CIDR matches Dennis's `proxy` network exactly — verify
  # with `docker network inspect proxy` if the network is ever recreated.
  set_real_ip_from 10.0.9.0/24;
  real_ip_header CF-Connecting-IP;
  real_ip_recursive on;

  # Browser security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob: https://view.officeapps.live.com; frame-ancestors 'none';" always;

  # Keep request bodies bounded; the app also validates lower logical limits.
  client_max_body_size 50M;

  # Give users enough time to upload larger bodies
  client_body_timeout 60s;

  root /usr/share/nginx/html;
  index index.html;

  # Defer DNS resolution to request time so nginx starts even if backend is down.
  # Note: proxy_pass with a variable skips automatic URI stripping, so we use
  # rewrite to manually strip the /api/ prefix before forwarding.
  resolver 127.0.0.11 valid=10s;
  set $bff ${BFF_BASE_URL};

  # Proxy API requests to backend service inside docker network
  location ^~ /api/v1/attachments/preview/ {
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self';" always;

    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location ^~ /api/v1/attachments/public/ {
    # Office Online (embed.aspx) is the only legitimate cross-origin reader, and
    # Microsoft fetches the doc server-side (no Origin header) — so this scoping
    # does NOT gate the viewer; it only stops arbitrary sites' JS from reading
    # the blob with a leaked short-lived token. Never widen back to "*".
    add_header Access-Control-Allow-Origin "https://view.officeapps.live.com" always;
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Range, Content-Type" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    if ($request_method = OPTIONS) {
      return 204;
    }

    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;
    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }

  # Inference run routes: REST (start, cancel, list, legacy SSE stream) and the
  # WebSocket endpoint share this prefix. Same upstream as /api/ but with the
  # Upgrade headers forwarded so the WS handshake succeeds, and long timeouts
  # so live-tailing streams aren't dropped by an idle-connection cap.
  location ^~ /api/v1/inference/runs/ {
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;

    # WebSocket upgrade plumbing — harmless on regular HTTP requests because
    # $http_upgrade is empty there and $connection_upgrade maps to "close".
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_request_buffering off;
    proxy_buffering off;
    gzip off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/ {
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $bff;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Internal-Proxy-Secret ${TRUSTED_PROXY_SECRET};
    proxy_set_header X-Request-ID $req_id;

    # Forward Range headers for partial content support
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;

    # Helpful for big requests: stream directly to backend instead of buffering to disk
    proxy_request_buffering off;

    # Don't buffer responses; stream to client for SSE and long downloads
    proxy_buffering off;

    gzip off;  # or ensure octet-stream isn't in gzip_types

    # Avoid premature timeouts while backend reads/processes big bodies
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Liveness probe for the container healthcheck — answered with a bare 200 and
  # kept out of the access log so the 30s wget probe doesn't spam it.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Single Page App routing + static assets
  location / {
    try_files $uri $uri/ /index.html;
  }
}
