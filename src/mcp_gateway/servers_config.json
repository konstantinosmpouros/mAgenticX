{
  "tavily": {
    "command": "npx",
    "args": [
      "-y",
      "tavily-mcp@latest"
    ],
    "env": {"TAVILY_API_KEY": "${TAVILY_API_KEY}"}
  },
  "serpapi": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-serpapi",
      "--api-key",
      "${SERPAPI_API_KEY}"
    ]
  },
  "filesystem": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "/app/data/"
    ]
  }
}
