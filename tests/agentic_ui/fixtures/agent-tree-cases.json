      ],
      "errors": ["subagents.0.subagents.0.name"]
    },
    {
      "name": "the same name in two branches is fine",
      "tools": [],
      "subagents": [
        { "name": "left", "description": "L.", "subagents": [{ "name": "checker", "description": "C." }] },
        { "name": "right", "description": "R.", "subagents": [{ "name": "checker", "description": "C." }] }
      ],
      "errors": []
    },
    {
