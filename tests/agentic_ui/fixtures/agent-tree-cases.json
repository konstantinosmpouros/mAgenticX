      "subagents": [
        {
          "name": "researcher",
          "description": "Finds sources.",
          "tools": [{ "server_id": "web", "tool_name": "search" }],
          "subagents": [
            {
              "name": "fact-checker",
              "description": "Checks one claim.",
              "subagents": [{ "name": "source-checker", "description": "Rates a source." }]
            }
          ]
        },
        { "name": "writer", "description": "Writes the brief." }
      ],
      "errors": []
    },
    {
      "name": "a fourth level",
      "tools": [],
      "subagents": [
        {
          "name": "a",
          "description": "A.",
          "subagents": [
            {
              "name": "b",
              "description": "B.",
              "subagents": [
                { "name": "c", "description": "C.", "subagents": [{ "name": "d", "description": "D." }] }
              ]
            }
          ]
        }
      ],
      "errors": ["subagents.0.subagents.0.subagents.0.subagents.0"]
    },
    {
