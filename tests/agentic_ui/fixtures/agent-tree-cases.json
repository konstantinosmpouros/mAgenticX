    },
    {
      "name": "a name over 48 characters",
      "tools": [],
      "subagents": [{ "name": "a-very-long-sub-agent-name-that-goes-on-and-on-and-on", "description": "Long." }],
      "errors": ["subagents.0.name"]
    },
    {
      "name": "a missing description",
      "tools": [],
      "subagents": [{ "name": "quiet", "description": "" }],
      "errors": ["subagents.0.description"]
    },
    {
      "name": "a tool its parent does not have",
      "tools": [{ "server_id": "web", "tool_name": "search" }, { "server_id": "web", "tool_name": "fetch" }],
      "subagents": [
        {
          "name": "researcher",
          "description": "R.",
          "tools": [{ "server_id": "web", "tool_name": "search" }],
