          "additionalProperties": true,
          "description": "State fields to write after the node runs: {field: value}. Values are templates and may read {{output.<path>}}.",
          "maxProperties": 32,
          "title": "Assign",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "description": "State field → value; values are templates.",
          "maxProperties": 32,
          "minProperties": 1,
          "title": "Values",
          "type": "object",
          "x-widget": "assign"
        }
      },
      "required": [
