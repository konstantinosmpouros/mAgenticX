              "enum": [
                "previous",
                "last",
                "steps",
                "none"
              ],
              "title": "Mode",
              "type": "string"
            },
            "count": {
              "default": 3,
              "description": "How many steps, for mode last.",
              "maximum": 10,
              "minimum": 1,
              "title": "Count",
              "type": "integer"
            },
            "steps": {
              "description": "Step ids, for mode steps.",
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
                "type": "string"
              },
              "maxItems": 20,
