        },
        "seconds": {
          "maximum": 600,
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "required": [
        "seconds"
      ],
      "title": "WaitConfig",
      "type": "object"
    }
  },
  {
