{
  "version": 1,
  "name": "Wait for a job, then ask before publishing",
  "description": "Polls a job URL until it reports ready (at most 3 retries), then asks for approval before ending.",
  "inputs": [
    {"name": "job_url", "type": "string", "required": true, "description": "Status endpoint of the job"},
    {"name": "token", "type": "string", "default": "", "description": "Bearer token sent with each poll"}
  ],
  "state": [
    {"name": "attempts", "type": "number", "reducer": "overwrite", "default": 0},
    {"name": "history", "type": "array", "reducer": "append"},
    {"name": "last_status", "type": "string", "reducer": "overwrite", "persist": true},
    {"name": "decision", "type": "string", "reducer": "overwrite", "default": "none"}
  ],
  "nodes": [
    {"id": "start", "kind": "trigger.manual", "label": "Run now", "config": {}, "position": {"x": 0, "y": 0}},
    {
      "id": "poll",
      "kind": "fetch",
      "label": "Poll the job",
      "config": {
        "method": "GET",
        "url": "{{input.job_url}}",
        "headers": {"Authorization": "Bearer {{input.token}}"},
        "timeout_seconds": 10,
        "response_type": "json",
        "assign": {"history": "{{output.body.status}}", "last_status": "{{output.body.status}}"}
      },
      "position": {"x": 240, "y": 0}
    },
    {
      "id": "is_ready",
      "kind": "condition",
      "label": "Ready?",
      "config": {
        "mode": "all",
        "rules": [
          {"path": "nodes.poll.output.status", "op": "eq", "value": 200},
          {"path": "nodes.poll.output.body.status", "op": "eq", "value": "ready"}
        ]
      },
      "position": {"x": 480, "y": 0}
    },
    {
      "id": "retry",
      "kind": "loop",
      "label": "Retry",
      "config": {
        "max_iterations": 3,
        "while": [{"path": "nodes.poll.output.body.status", "op": "ne", "value": "failed"}],
        "assign": {"attempts": "{{output.iteration}}"}
      },
      "position": {"x": 480, "y": 200}
    },
    {
      "id": "approve",
      "kind": "approval",
      "label": "Publish?",
      "config": {
        "message": "The job is ready. Publish its result?",
        "payload": {"job": "{{input.job_url}}", "result": "{{nodes.poll.output.body}}"},
        "assign": {"decision": "{{output.decision}}"}
      },
      "position": {"x": 720, "y": 0}
    },
    {
      "id": "finish",
      "kind": "end",
      "label": "Done",
      "config": {
        "outputs": {
          "status": "{{state.last_status}}",
          "attempts": "{{state.attempts}}",
          "history": "{{state.history}}",
          "decision": "{{state.decision}}"
        }
      },
      "position": {"x": 960, "y": 100}
    }
  ],
  "edges": [
    {"id": "e1", "source": "start", "target": "poll"},
    {"id": "e2", "source": "poll", "target": "is_ready"},
    {"id": "e3", "source": "is_ready", "target": "approve", "branch": "true"},
    {"id": "e4", "source": "is_ready", "target": "retry", "branch": "false"},
    {"id": "e5", "source": "retry", "target": "poll", "branch": "continue"},
    {"id": "e6", "source": "retry", "target": "finish", "branch": "done"},
    {"id": "e7", "source": "approve", "target": "finish", "branch": "approved"},
    {"id": "e8", "source": "approve", "target": "finish", "branch": "rejected"}
  ]
}
